{
  "name": "reclash-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt generate",
    "generate": "npm run build",
    "preview": "wrangler pages dev .output/public --ip 127.0.0.1 --port 4173",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "check": "npm run typecheck && npm run build && node scripts/check-static.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.3"
  }
}
